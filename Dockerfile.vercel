FROM php:8.4-cli

# Instala dependências do sistema e extensões necessárias para o Composer e ZIP
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    && docker-php-ext-install zip

# Copia o Composer oficial
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copia os arquivos do projeto para dentro do container
COPY . .

# Instala as dependências do PHPMailer e Dotenv via Composer
RUN if [ -f composer.json ]; then composer install --no-dev --optimize-autoloader; fi

# A Vercel injeta dinamicamente a porta na variável de ambiente $PORT
# Usamos um script inline para substituir a porta no servidor embutido do PHP
CMD php -S 0.0.0.0:${PORT:-8080} -t pages